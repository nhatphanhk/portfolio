# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# DATABASE_URL: Runtime query connection string (pooled if using Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# DIRECT_URL: Direct database connection string (used by Prisma for migrations)
DIRECT_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# ==========================================
# NEXTAUTH / AUTH.JS
# ==========================================
# Generate secret: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-chars"
NEXTAUTH_SECRET="your-auth-secret-min-32-chars"
AUTH_URL="http://localhost:3000"

# ==========================================
# ADMIN DEFAULT CREDENTIALS (Fallback)
# ==========================================
ADMIN_EMAIL="admin@portfolio.dev"
ADMIN_PASSWORD_HASH=""
ADMIN_SETUP_KEY=""

# ==========================================
# SITE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ==========================================
# GOOGLE GEMINI AI (Resume AI Assistant)
# ==========================================
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
