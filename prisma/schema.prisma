// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatarUrl String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogs    Blog[]
  projects Project[]
  media    Media[]

  @@map("users")
}

model Blog {
  id           String     @id @default(uuid())
  title        String
  slug         String     @unique
  content      String
  excerpt      String?
  thumbnailUrl String?
  status       PostStatus @default(DRAFT)
  viewCount    Int        @default(0)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  tags        BlogTag[]
  seriesId    String?
  seriesOrder Int?         @default(0)
  series      BlogSeries?  @relation(fields: [seriesId], references: [id])

  @@index([status])
  @@index([publishedAt])
  @@index([slug])
  @@map("blogs")
}

model BlogTag {
  blogId String
  tagId  String

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@map("blog_tags")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs    BlogTag[]
  projects ProjectTag[]

  @@map("tags")
}

model Project {
  id           String     @id @default(uuid())
  title        String
  slug         String     @unique
  description  String?
  content      String?
  thumbnailUrl String?
  demoUrl      String?
  repoUrl      String?
  status       PostStatus @default(DRAFT)
  featured     Boolean    @default(false)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  authorId String
  author   User           @relation(fields: [authorId], references: [id])
  tags     ProjectTag[]
  images   ProjectImage[]

  @@index([status])
  @@index([featured])
  @@map("projects")
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

model ProjectImage {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model Skill {
  id        String        @id @default(uuid())
  name      String
  iconUrl   String?
  level     Int? // 1-5
  category  SkillCategory
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("skills")
}

model Certification {
  id            String    @id @default(uuid())
  name          String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  description   String?
  logoUrl       String?
  status        CertStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("certifications")
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String   // e.g. "GitHub", "LinkedIn", "Twitter"
  url       String
  iconName  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("social_links")
}

model Experience {
  id           String    @id @default(uuid())
  company      String
  position     String
  description  String?
  achievements String?   // newline-separated bullet points
  techStack    String?   // comma-separated
  logoUrl      String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("experiences")
}

model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactStatus @default(UNREAD)
  notes     String?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contacts")
}

model Media {
  id           String   @id @default(uuid())
  url          String
  filename     String
  mimetype     String?
  size         Int?
  fileType     String?  // 'avatar', 'project', 'blog', 'document'
  altText      String?
  createdAt    DateTime @default(now())

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@map("media")
}

model Profile {
  id              String   @id @default(uuid())
  name            String
  handle          String?
  title           String
  tagline         String?
  bio             String?
  bio2            String?
  location        String?
  email           String?
  phone           String?
  resumeUrl       String?
  avatarUrl       String?
  careerObjective String?
  softSkills      String?  // comma-separated
  interests       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("profiles")
}

model Education {
  id           String    @id @default(uuid())
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  gpa          String?
  description  String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("education")
}

model Achievement {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime?
  category    String?   // "award", "hackathon", "academic", "work"
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("achievements")
}

model SpokenLanguage {
  id        String   @id @default(uuid())
  language  String
  level     String   // "Native", "Fluent", "Professional", "Intermediate", "Basic"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spoken_languages")
}

model Activity {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        String?   // "club", "volunteer", "mentoring", "opensource"
  startDate   DateTime?
  endDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("activities")
}

model BlogSeries {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blogs Blog[]

  @@map("blog_series")
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("text") // "text", "number", "url", "html"
  label     String?  // Human-readable label for admin UI
  grp       String?  // "hero", "about", "stats", "bpsc"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model ContentTranslation {
  id          String   @id @default(uuid())
  entityType  String   // "blog", "project", "series", "profile"
  entityId    String
  locale      String   // "vi" or "en"
  title       String?
  excerpt     String?
  content     String?  @db.Text
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, entityId, locale])
  @@index([entityType, entityId, locale])
  @@map("content_translations")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DEVOPS
  TOOLS
  OTHER
  LANGUAGE        // Programming Languages
  FRAMEWORK       // Frameworks/Libraries
  DATABASE        // Databases
  CLOUD           // Cloud Platforms
  IAC             // Infrastructure as Code
  MONITORING      // Monitoring & Logging
  VERSION_CONTROL // Version Control
}

enum CertStatus {
  ACTIVE
  EXPIRED
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
}